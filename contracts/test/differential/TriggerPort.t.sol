pragma solidity 0.8.26;

import {Test} from "forge-std/Test.sol";
import {PriceLib} from "../../src/libraries/PriceLib.sol";
import {FlowBucketLib} from "../../src/libraries/FlowBucketLib.sol";

/// @notice The research backtest flags swaps with a Python port of the trigger rules (research/tsr/triggers.py).
/// These cases, generated by research/tsr/vectors.py, must give identical results through the contracts'
/// libraries, or the backtest would be measuring a different mechanism.
contract TriggerPortDifferentialTest is Test {
    string internal json;

    function setUp() public {
        // Reads only the generated vector file, which fs_permissions scopes to research/reference/vectors.
        // forge-lint: disable-next-line(unsafe-cheatcode)
        json = vm.readFile("../research/reference/vectors/trigger_vectors.json");
    }

    function _key(string memory list, uint256 i, string memory field) internal pure returns (string memory) {
        return string.concat(".", list, "[", vm.toString(i), "].", field);
    }

    function test_SignedGap_MatchesPort() public view {
        for (uint256 i; i < 64; ++i) {
            uint256 ref = vm.parseUint(vm.parseJsonString(json, _key("gaps", i, "ref")));
            uint256 pool = vm.parseUint(vm.parseJsonString(json, _key("gaps", i, "pool")));
            bool buys = vm.parseJsonBool(json, _key("gaps", i, "buys"));
            int256 expected = vm.parseInt(vm.parseJsonString(json, _key("gaps", i, "out")));
            assertEq(PriceLib.signedGapBps(ref, pool, buys), expected);
        }
    }

    function test_PoolPrice_MatchesPort() public view {
        for (uint256 i; i < 64; ++i) {
            uint160 s = uint160(vm.parseUint(vm.parseJsonString(json, _key("prices", i, "sqrt"))));
            bool risky0 = vm.parseJsonBool(json, _key("prices", i, "risky0"));
            uint256 expected = vm.parseUint(vm.parseJsonString(json, _key("prices", i, "out")));
            uint256 got = PriceLib.poolPriceX36(s, risky0);
            // Above sqrt 2^128 the contract squares in two rounding steps (PriceLib's comment); the port
            // squares exactly, so allow the documented relative error below 2^-32.
            if (s <= type(uint128).max) assertEq(got, expected);
            else assertApproxEqRel(got, expected, 1e9);
        }
    }

    function test_FlowBucket_MatchesPort() public view {
        for (uint256 i; i < 16; ++i) {
            _checkFlow(string.concat(".flows[", vm.toString(i), "]"));
        }
    }

    struct Flow {
        uint256 nMin;
        uint32 h;
        uint256[] ts;
        string[] ns;
        bool[] buys;
        bool[] hits;
    }

    function _checkFlow(string memory base) internal view {
        Flow memory f = Flow({
            nMin: vm.parseUint(vm.parseJsonString(json, string.concat(base, ".nMin"))),
            h: uint32(vm.parseJsonUint(json, string.concat(base, ".h"))),
            ts: vm.parseJsonUintArray(json, string.concat(base, ".t")),
            ns: vm.parseJsonStringArray(json, string.concat(base, ".n")),
            buys: vm.parseJsonBoolArray(json, string.concat(base, ".buy")),
            hits: vm.parseJsonBoolArray(json, string.concat(base, ".hits"))
        });
        uint104 buy;
        uint104 sell;
        uint40 last = 1_000;
        for (uint256 j; j < f.ts.length; ++j) {
            bool hit;
            (buy, sell, hit) =
                FlowBucketLib.update(buy, sell, last, uint40(f.ts[j]), f.nMin, f.h, vm.parseUint(f.ns[j]), f.buys[j]);
            last = uint40(f.ts[j]);
            assertEq(hit, f.hits[j]);
        }
    }
}
