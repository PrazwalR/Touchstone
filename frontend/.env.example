# Every key is optional. The page is read-only and holds no secrets; anything set here ships in the public bundle.

# RPC origin for read calls. Leave unset to use the chain's publicRpc from deployments/<chain>.json.
# Never put a keyed RPC URL here (spec 0.7): it would be published to every visitor.
VITE_RPC_URL=

# Seconds between live reads of pool, hook and calendar state. Leave unset for 15.
VITE_POLL_SECONDS=
# Optional public read-only indexer API origin/base path. Never include a secret.
VITE_HISTORY_URL=

# Deployment name from frontend/deployments (default arbitrum-sepolia).
# Use base-sepolia after its deployment has been synced.
VITE_CHAIN=
