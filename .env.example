# Every variable Touchstone reads. Copy to .env and fill in; .env is never committed.

# --- RPC endpoints (bots, fork tests, deploy scripts, research ingest) ---
# HTTPS RPC for Arbitrum Sepolia (chain id 421614).
ARBITRUM_SEPOLIA_RPC_URL=
# HTTPS RPC for Base Sepolia (chain id 84532).
BASE_SEPOLIA_RPC_URL=
# HTTPS RPC for Unichain Sepolia (chain id 1301); a candidate chain, see decision 0040.
UNICHAIN_SEPOLIA_RPC_URL=
# Archive RPCs for research ingest (E1-E4); one per chain backtested.
ETHEREUM_ARCHIVE_RPC_URL=
ARBITRUM_ARCHIVE_RPC_URL=
BASE_ARCHIVE_RPC_URL=

# --- Explorer verification (scripts/deploy-testnet.sh passes it to forge --verify) ---
# One Etherscan API V2 key (etherscan.io, free tier) verifies on every chain, Arbitrum and Base Sepolia included.
ETHERSCAN_API_KEY=

# --- Pyth Hermes (keeper, research) ---
# Base URL of the Hermes service, without a trailing slash.
HERMES_URL=
# Hermes API key; required since the Pyth Core upgrade of 26 Aug 2026. The value is sent verbatim in
# the header below, so include the scheme: Hermes at hermes.pyth.network takes "Bearer <key>".
HERMES_API_KEY=
# Name of the HTTP header that carries the key: Authorization for hermes.pyth.network (checked 28 Oct 2026).
HERMES_API_KEY_HEADER=
# Per-request timeout in milliseconds.
HERMES_TIMEOUT_MS=

# --- Keeper (backend/keeper) ---
# RPC the keeper reads and sends through, and that chain's id.
KEEPER_RPC_URL=
KEEPER_CHAIN_ID=
# Encrypted keystore (cast wallet import) and a file holding its password, outside the repository.
KEEPER_KEYSTORE_PATH=
KEEPER_KEYSTORE_PASSWORD_FILE=
# Where the keeper persists its log cursor and open records between restarts.
KEEPER_STATE_PATH=
# Tip must exceed gas cost by this margin, in basis points, to settle for profit.
KEEPER_MIN_MARGIN_BPS=
# Also settle unprofitable records that retain value for LPs, and benign ones with an empty rebate pool: true | false.
KEEPER_SETTLE_AT_LOSS=
# Poll interval in milliseconds; block range per eth_getLogs call.
KEEPER_POLL_INTERVAL_MS=
KEEPER_LOG_BLOCK_RANGE=
# How many drips to send per vesting period (spec §15.1 step 7 says about ten).
KEEPER_DRIPS_PER_PERIOD=
# Pyth price id of the chain's native token, to value gas.
KEEPER_NATIVE_PRICE_ID=
# Comma-separated addresses whose ledger balances the keeper pushes; may be empty.
KEEPER_PUSH_RECIPIENTS=
# First block to read DepositTaken from (the hook's deployment block).
KEEPER_START_BLOCK=
# Optional: file the keeper writes after each tick for the alert monitor (account, a day of gas spend, Hermes
# error rate), and the trailing window in seconds for that rate. Set both or neither.
KEEPER_METRICS_PATH=
KEEPER_HERMES_WINDOW_S=

# --- Indexer (backend/indexer) ---
# Short chain label used as the key in every table, for example arbitrum-sepolia.
INDEXER_CHAIN=
INDEXER_RPC_URL=
# SQLite file path in development.
INDEXER_DATABASE_PATH=
# Blocks to wait before a log is treated as final.
INDEXER_CONFIRMATIONS=
# First block to index from (the factory's deployment block), block range per call, poll interval in ms.
INDEXER_START_BLOCK=
INDEXER_BLOCK_RANGE=
INDEXER_POLL_INTERVAL_MS=

# --- Deployed addresses (keeper and indexer), from DEPLOYMENTS.md ---
TOUCHSTONE_HOOK=
TOUCHSTONE_SETTLER=
TOUCHSTONE_FACTORY=
TOUCHSTONE_LEDGER=
POOL_MANAGER=

# --- Deploy ---
# cast wallet account name used by forge scripts (--account); scripts/deploy-testnet.sh defaults to touchstone-deployer.
DEPLOYER_ACCOUNT=
# The keystore's address; forge plans the deployment from it (--sender).
DEPLOYER_ADDRESS=
# Chain the deploy scripts target; selects contracts/script/config/<CHAIN>.json, for example arbitrum-sepolia.
CHAIN=
# Optional: where DeployCore and CreatePool write addresses; defaults to contracts/deployments/<CHAIN>.json.
DEPLOYMENT_OUT=

# Read-only indexer API; start with pnpm -C backend/indexer api
INDEXER_API_HOST=
INDEXER_API_PORT=
# Comma-separated exact origins, no trailing slash or wildcard
INDEXER_API_ORIGINS=
INDEXER_API_REQUESTS_PER_WINDOW=
INDEXER_API_WINDOW_MS=
INDEXER_API_MAX_CLIENTS=
INDEXER_API_MAX_PAGE_SIZE=

# Seeded testnet demonstration bots. All amounts are integer token base units.
BOT_RPC_URL=
BOT_CHAIN_ID=
# retail, outsider, holder (swaps only while holding the licence, never posting a deposit) or bidder
BOT_MODE=
BOT_SEED=
# Explicit true or false. False simulates without loading the signing key.
BOT_SUBMIT=
BOT_ACCOUNT=
BOT_KEYSTORE_PATH=
BOT_PASSWORD_FILE=
BOT_DEPLOYMENT_FILE=
BOT_ZERO_FOR_ONE=
BOT_AMOUNT_MIN=
BOT_AMOUNT_MAX=
BOT_MIN_NET_OUT=
BOT_MIN_GROSS_OUT=
BOT_MAX_DEPOSIT=
BOT_SQRT_PRICE_LIMIT_X96=
BOT_DEADLINE_SECONDS=
BOT_ITERATIONS=
BOT_INTERVAL_MS=
BOT_MAX_GAS=
BOT_MAX_GAS_PRICE_WEI=
BOT_MIN_EDGE_BPS=
BOT_PRICE_MAX_AGE_SECONDS=
BOT_MAX_CONF_BPS=
# Bidder mode only: most rent per second, seconds of rent the deposit covers (at least the notice), and the most
# quote base units one bid may lock.
BOT_LEASE_MAX_RENT=
BOT_LEASE_SECONDS=
BOT_LEASE_MAX_DEPOSIT=

# Optional auction address; omit entirely for the existing pre-licence deployment.
TOUCHSTONE_LICENCE=
# Required positive seconds between accrual attempts when the auction is configured.
KEEPER_ACCRUE_INTERVAL_S=

# Alert monitor (spec 15.6): reads the indexer database, the keeper metrics file and the chain; posts to Discord.
MONITOR_RPC_URL=
MONITOR_CHAIN_ID=
# The indexer's SQLite file, opened read-only, and the chain label the indexer writes under.
MONITOR_DATABASE_PATH=
MONITOR_INDEXER_CHAIN=
MONITOR_KEEPER_METRICS_PATH=
# A Discord channel webhook (Server settings, Integrations, Webhooks). Secret: anyone with it can post.
MONITOR_DISCORD_WEBHOOK_URL=
MONITOR_INTERVAL_MS=
# A firing alert repeats at most this often, in seconds.
MONITOR_COOLDOWN_S=
# Spec: alert when p95 settlement lag exceeds the pool's settle delay plus this many seconds (30).
MONITOR_LAG_SLACK_S=
# Settled records per pool in the lag sample.
MONITOR_LAG_SAMPLE=
# Spec: alert when Hermes errors exceed this share of requests, in basis points (100 = 1%).
MONITOR_HERMES_ERROR_BPS=
# Fewer requests than this in the keeper's window are not judged.
MONITOR_HERMES_MIN_REQUESTS=
# Warn this many seconds before a lease runs out or a pending bid activates.
MONITOR_LEASE_WARN_S=
# Keeper metrics older than this many seconds mean the keeper is down or failing.
MONITOR_KEEPER_STALE_S=
# Keeper balance floor in wei while there is no day of spend to measure.
MONITOR_MIN_KEEPER_BALANCE_WEI=
